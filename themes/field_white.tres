[gd_resource type="StyleBoxFlat" format=3]

; DORO 窗口底部的输入框：白底 + 一圈淡边 + 圆角。
;
; 这里和聊天栏那个相反 —— 它需要被看见。之前用了和面板一样的粉色，
; 结果整条输入区糊在面板里，谁都看不出哪儿能打字。白底才立得起来。
; 圆角 15 配 30px 高，正好是个胶囊形，和微信输入框的观感接近。

[resource]
bg_color = Color(1, 1, 1, 1)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.898039, 0.788235, 0.827451, 1)
corner_radius_top_left = 15
corner_radius_top_right = 15
corner_radius_bottom_right = 15
corner_radius_bottom_left = 15
