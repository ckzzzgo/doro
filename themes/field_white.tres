[gd_resource type="StyleBoxFlat" format=3]

; DORO 窗口底部的输入框：白底 + 一圈淡边 + 胶囊圆角。
;
; content_margin 是必须的：圆角 15 意味着左右各有 15px 是弧线，文字若从 x=0 开始排，
; 会直接压在弧线上甚至探出去（用户反馈的"文字穿模"）。左右各留 14px 让文字待在直边区域内。

[resource]
content_margin_left = 14.0
content_margin_top = 4.0
content_margin_right = 14.0
content_margin_bottom = 4.0
bg_color = Color(1, 1, 1, 1)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.898039, 0.788235, 0.827451, 1)
corner_radius_top_left = 15
corner_radius_top_right = 15
corner_radius_bottom_right = 15
corner_radius_bottom_left = 15
