[gd_resource type="StyleBoxFlat" format=3]

; 输入框专用：比面板底色再深一点，读起来才像「一个可以往里打字的凹槽」，
; 而不是面板上一块没边界的白。边框比面板细（1px）、圆角比面板小（8），
; 层级上从属于面板。

[resource]
bg_color = Color(1, 0.913725, 0.941176, 1)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.862745, 0.654902, 0.698039, 1)
corner_radius_top_left = 8
corner_radius_top_right = 8
corner_radius_bottom_right = 8
corner_radius_bottom_left = 8
