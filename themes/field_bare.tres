[gd_resource type="StyleBoxFlat" format=3]

; 聊天栏里的输入框：完全透明，什么都不画。
;
; 走到这一步踩了两次：
;   第一次给它加了左右两条竖线 —— 那两条线把外面聊天栏的圆角边框从中间切开了。
;   第二次去掉边框但把底色设成和面板一样的粉 —— 看着像"没有底色"，其实是一块
;   不透明的色块，而它是面板的子节点、画在面板之上，于是把外框那 2px 边线压掉了一段。
;   同色所以看不出是"盖住"，但外框确实被截断，正是用户反馈的现象。
;
; 结论：底色必须真透明（alpha 0），不是"和背景同色"。同色只是看不见，透明才是不遮挡。
; 顺带留一点内边距，免得文字紧贴左边那个图标按钮。

[resource]
content_margin_left = 8.0
content_margin_top = 0.0
content_margin_right = 8.0
content_margin_bottom = 0.0
bg_color = Color(1, 1, 1, 0)
border_width_left = 0
border_width_top = 0
border_width_right = 0
border_width_bottom = 0
