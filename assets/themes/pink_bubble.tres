[gd_resource type="StyleBoxFlat" format=3]

; 聊天气泡。两边（Doro 和人）用同一份 —— 区分靠左右位置和头像，不靠颜色。
; 比面板底色再白一点，这样气泡能从面板上"浮"起来。

[resource]
bg_color = Color(1, 0.980392, 0.988235, 1)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.909804, 0.800000, 0.835294, 1)
corner_radius_top_left = 12
corner_radius_top_right = 12
corner_radius_bottom_right = 12
corner_radius_bottom_left = 12
