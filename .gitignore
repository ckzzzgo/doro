.godot
.vs
.vscode
.idea

/export/

config.ini

# macOS
.DS_Store

# Godot 的导入缓存目录（.godot/ 已在文件开头忽略）。
#
# 注意 *.import 本身**要入库**：它记着每个资源的 uid，而场景和 export_presets
# 是按 uid 引用资源的。不入库的话别人 clone 下来 Godot 会重新生成一套新 uid，
# 引用就断了 —— 之前 app_icon.png.import 没入库，全新 clone 直接报
# "Unrecognized UID: uid://dnct8jchwvs7y"，导出的 exe 图标是错的。
#
# docs/ 下有 .gdignore，Godot 不会去导入，那里若还残留 .import 属历史僵尸，不入库。
docs/**/*.import

# Python 工具的字节码缓存（tools/gen_keyboard.py）
__pycache__/
*.pyc

# C# 构建中间产物（本地构建，不入库；helpers/DoroInputBridge.exe 为运行时需要的功能产物，保留入库）
helpers/bin/
helpers/obj/
*.pdb
*.user

# 版本清单签名私钥。绝不能入库 —— 一旦进了仓库，任何人都能伪造出新版本的下载清单，
# 客户端的内嵌公钥照样验证通过，整条签名防线就形同虚设。
tools/keys/