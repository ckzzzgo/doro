; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Dororo"
config/version="1.4.4"
run/main_scene="uid://gfuvhyo1xjl4"
config/features=PackedStringArray("4.4", "C#", "Mobile")
run/max_fps=30
run/low_processor_mode=true
boot_splash/bg_color=Color(0, 0, 0, 0)
boot_splash/show_image=false
config/icon="uid://dbgr0uu8hus3f"

[autoload]

MouseTracker="*res://scripts/cs/MouseTracker.cs"
Config="*res://scripts/gd/utils/config/config_manager.gd"
WindowManager="*res://scripts/cs/WindowManager.cs"
MouseDetection="*res://scripts/cs/MouseDetection.cs"
AutoStarter="*res://scripts/cs/AutoStarter.cs"

[display]

window/size/viewport_width=640
window/size/viewport_height=640
window/size/borderless=true
window/size/transparent=true
window/energy_saving/keep_screen_on=false
window/subwindows/embed_subwindows=false
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/per_pixel_transparency/allowed=true
window/vsync/vsync_mode=0

[dotnet]

project/assembly_name="Dororo"

[file_customization]

folder_colors={
"res://export/": "gray"
}

[physics]

2d/run_on_separate_thread=true
3d/run_on_separate_thread=true

[rendering]

renderer/rendering_method="mobile"

; 窗口逐像素透明在 Vulkan 路径上做不出来 —— 至少在混合显卡笔记本上不行。
; 用户那台是 Intel Iris Xe 集显负责显示输出、NVIDIA RTX 3060 独显负责渲染，
; 跨 GPU 的透明合成失效，整个窗口变成不透明黑底。实测数据（1.4.2 那台机器）：
;
;   默认 Vulkan Forward Mobile → 黑底，而且日志里连驱动信息行都没打出来
;   D3D12                      → 透明正常，日志完整
;   OpenGL                     → 用户说正常，但日志同样没有驱动行，且与 1.4.1
;                                的实际反馈（OpenGL 就是黑的）矛盾，不采信
;
; 这台开发机是单显卡 Quadro，三种路径都正常，所以本机怎么测都测不出来。
;
; 选 D3D12 而不是 OpenGL 的另一个理由：Windows 的桌面合成本身就是 D3D 做的，
; 透明窗口走这条路最短。fallback_to_vulkan 默认为 true，D3D12 起不来的机器
; 会自动退回 Vulkan，不会变成打不开。
rendering_device/driver.windows="d3d12"
anti_aliasing/dynamic_fonts/use_oversampling=true
